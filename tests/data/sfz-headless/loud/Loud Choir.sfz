// Headless-regression fixture (sappchoir #1): the LOUD reference instrument.
// A sustaining, looped tone — the station holds chords for seconds, so a
// one-shot blip would not measure the thing that broke.
<region> sample=../choir-tone.wav lokey=0 hikey=127 pitch_keycenter=60
         loop_mode=loop_continuous loop_start=0 loop_end=47999
         ampeg_attack=0.02 ampeg_release=0.3 volume=0
